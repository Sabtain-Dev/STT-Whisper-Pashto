# ── SYSTEM OPERATIONAL PROFILE ──────────────────────────────────────────────
APP_NAME="Pashto ASR Pipeline"
ENV_MODE=development # development | production
DEBUG_MODE=true

# ── NETWORK BINDINGS ────────────────────────────────────────────────────────
API_BASE_URL=http://localhost:8000
API_V1_STR=/api/v1
STREAMLIT_PORT=8501
FASTAPI_PORT=8000

# ── HUGGING FACE RESOURCE POINTERS ──────────────────────────────────────────
HF_MODEL_ID=https://huggingface.co/Sabtain-Dev/STT-Whisper-Pashto
KAGGLE_DATASET_REF=https://www.kaggle.com/datasets/itssabtain/pashto-asr-dataset
HF_TOKEN= "Your_Hugging_Face_API_Token_Here" # Obtain from https://huggingface.co/settings/tokens

# ── ENGINE CONSTRAINTS ──────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=25
API_REQUEST_TIMEOUT=600