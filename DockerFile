# Use a lightweight optimized Python base layer
FROM python:3.10-slim

# Enforce Python environment optimization switches 
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    OMP_NUM_THREADS=2

# Install system dependencies required by audio vector loaders
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

# Copy dependency requirements files first to leverage build layer caching matrix
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy all project sub-modules into working directory boundaries
COPY . .

# Setup exposed communications port allocation map matching standard Uvicorn layouts
EXPOSE 8000

# Set running state target pointing to our decoupled API app directory node entry
CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]