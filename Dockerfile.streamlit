# Dockerfile.streamlit

FROM python:3.10-slim

WORKDIR /workspace

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

COPY requirements.txt .

RUN pip install --no-cache-dir -r requirements.txt

# Copy the frontend dashboard (includes app/.streamlit/config.toml and
# app/static/ — no longer excluded now that .dockerignore only ignores
# .streamlit/cache/, not the whole .streamlit/ directory)
COPY app/ ./app/

EXPOSE 8501

HEALTHCHECK --interval=15s --timeout=5s --start-period=30s --retries=10 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8501/_stcore/health', timeout=3)" || exit 1

# Configure Streamlit to run transparently on container network ports
CMD ["python", "-m", "streamlit", "run", "app/app.py", "--server.port", "8501", "--server.address", "0.0.0.0"]